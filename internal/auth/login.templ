package auth

import "blog/internal/ui"

templ LoginPage(loginFailed bool) {
	@ui.Layout("Login") {
		<div class="mx-auto w-full max-w-sm px-4 py-10 sm:px-5">
			<form method="POST" action="/login">
				<h1 class="mb-6 text-2xl">Login</h1>
				if loginFailed {
					<p class="mb-4 text-[0.9rem] text-red-700">
						Invalid password
					</p>
				}
				<div class="mb-5">
					<label for="password" class="mb-1.5 block text-[0.85rem] text-muted">Password</label>
					<input
						id="password"
						name={ passwordFormField }
						type="password"
						required
						autocomplete="current-password"
						autofocus
						class="w-full rounded-md border border-line bg-white px-3 py-2 text-base outline-none focus:border-accent"
					/>
				</div>
				<button
					type="submit"
					class="w-full rounded-md bg-accent px-4 py-2 text-[0.95rem] text-white hover:bg-accent-hover"
				>
					Log in
				</button>
			</form>
		</div>
	}
}
