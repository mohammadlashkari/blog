package auth

import "blog/internal/ui"

templ LoginPage(loginFailed bool) {
	@ui.Layout("Login") {
		<div>
			<form method="POST" action="/login">
				<h1>Login</h1>
				if loginFailed {
					<p style="color: red;">
						Invalid password
					</p>
				}
				<div>
					<label for="password">Password</label>
					<input
						id="password"
						name={ passwordFormField }
						type="password"
						required
						autocomplete="current-password"
						autofocus
					/>
				</div>
				<button type="submit">
					Log in
				</button>
			</form>
		</div>
	}
}
