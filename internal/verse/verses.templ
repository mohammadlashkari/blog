package verse

import "blog/internal/ui"

// VersesPage is deliberately the one page off the shared --container-shell
// width. max-w-5xl (64rem) leaves room for three masonry columns at the
// 19rem column width below; the 56rem shell only fits two. Cards hold short
// quoted text, not the long-form prose the shell measure is tuned for, so the
// extra width costs nothing in readability here.
templ VersesPage(verses []Verse) {
	@ui.Layout("Verses", "Poems and quotes worth keeping", "verses", "en") {
		<section class="mx-auto w-full max-w-5xl px-4 sm:px-5">
			<h1 class="mb-1 text-3xl">Verses</h1>
			<p class="mb-7 text-muted">
				Poems and quotes I keep coming back to
			</p>
			if len(verses) == 0 {
				<p class="border-t border-line pt-6 text-[0.9rem] text-muted">Nothing here yet.</p>
			} else {
				<!-- below 664px only one 19rem column fits, and a lone column stretches to
				fill the container; the cap keeps that card from reaching a 90-character measure -->
				<div class="mx-auto max-w-[23rem] columns-[19rem] gap-4 min-[664px]:max-w-none">
					for _, v := range verses {
						@verseCard(v)
					}
				</div>
			}
		</section>
	}
}

templ verseCard(v Verse) {
	<figure
		dir={ v.Language.Dir() }
		lang={ v.Language.Lang() }
		class="mb-4 break-inside-avoid rounded-md border border-line bg-paper p-5"
	>
		<blockquote class="verse-body text-[0.98rem] whitespace-pre-wrap text-ink">
			{ v.Text }
		</blockquote>
		<figcaption class="text-[0.8rem] text-muted">
			&#8212; { v.Author }
		</figcaption>
	</figure>
}
