package post

import (
	"blog/internal/ui"
	"net/url"
)

templ PostPage(post uiPost, tags []Tag, htmlContent string, component templ.Component) {
	@ui.Layout(post.Title) {
		<article class="container post" dir={ dirOf(post.Language) } lang={ langOf(post.Language) }>
			<header class="post-header">
				<div class="post-date">
					{ post.DisplayDate }
				</div>
				<h1 class="post-title">{ post.Title }</h1>
				if len(tags) > 0 {
					<div class="post-tags">
						for _, tag := range tags {
							<a href={ templ.URL("/posts?tag=" + url.QueryEscape(tag.Name)) } class="tag">
								{ tag.Name }
							</a>
						}
					</div>
				}
			</header>
			<div class="post-content">
				@templ.Raw(htmlContent)
			</div>
			if component != nil {
				@component
			}
		</article>
	}
}
