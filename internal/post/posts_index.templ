package post

import (
	"blog/internal/ui"
	"net/url"
)

templ PostsIndexPage(
	english []yearGroup,
	farsi []yearGroup,
	tags []string,
) {
	@ui.Layout("Blog") {
		<header class="mx-auto w-full max-w-4xl px-4 sm:px-5">
			<h1 class="mb-1 text-3xl">Blog</h1>
			<p class="text-muted">Thoughts, notes, and experiments</p>
			<nav class="mt-7 border-t border-line pt-4">
				<ul class="flex flex-wrap gap-x-4 gap-y-1">
					for _, tag := range tags {
						<li>
							<a
								href={ templ.URL("/posts?tag=" + url.QueryEscape(tag)) }
								class="text-[0.85rem] text-muted hover:text-accent"
							>
								{ "#" + tag }
							</a>
						</li>
					}
				</ul>
			</nav>
		</header>
		<section class="mx-auto w-full max-w-4xl px-4 sm:px-5">
			<div class="mt-4 grid grid-cols-1 gap-10 min-[900px]:grid-cols-2 min-[900px]:gap-[clamp(2rem,5vw,4.5rem)]">
				<!-- English -->
				<section dir="ltr">
					for _, group := range english {
						@yearHeading(group.year)
						@PostList(group.posts)
					}
				</section>
				<!-- Farsi -->
				<section dir="rtl">
					for _, group := range farsi {
						@yearHeading(group.year)
						@PostList(group.posts)
					}
				</section>
			</div>
		</section>
	}
}

templ yearHeading(year string) {
	<h3 class="mt-8 mb-3 text-[0.78rem] font-semibold tracking-[0.06em] text-muted uppercase first:mt-0">
		{ year }
	</h3>
}

templ PostList(posts []uiPost) {
	<ul class="mb-6">
		for _, post := range posts {
			<li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-1.5">
				<a
					href={ templ.URL("/post/" + post.Slug) }
					class="hover:underline hover:decoration-accent/40 hover:underline-offset-[0.15em]"
				>
					{ post.Title }
				</a>
				<small class="shrink-0 text-[0.8rem] whitespace-nowrap text-muted tabular-nums">
					if post.IsFavorite {
						<span>★</span>
					}
					{ post.displayDate }
				</small>
			</li>
		}
	</ul>
}
