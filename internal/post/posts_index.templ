package post

import (
	"blog/internal/ui"
	"net/url"
)

templ PostsIndexPage(
	english []yearGroup,
	farsi []yearGroup,
	tags []string,
) {
	@ui.Layout("Blog") {
		<header class="container index-wide">
			<hgroup>
				<h1>Blog</h1>
				<p>Thoughts, notes, and experiments</p>
			</hgroup>
			<nav>
				<ul>
					for _, tag := range tags {
						<li>
							<a href={ templ.URL("/posts?tag=" + url.QueryEscape(tag)) } class="tag">
								{ tag }
							</a>
						</li>
					}
				</ul>
			</nav>
		</header>
		<section class="container index-wide">
			<div class="posts-grid">
				<!-- English -->
				<section dir="ltr">
					for _, group := range english {
						<h3>
							{ group.year }
						</h3>
						@PostList(group.posts)
					}
				</section>
				<!-- Farsi -->
				<section dir="rtl">
					for _, group := range farsi {
						<h3>
							{ group.year }
						</h3>
						@PostList(group.posts)
					}
				</section>
			</div>
		</section>
	}
}

templ PostList(posts []uiPost) {
	<ul>
		for _, post := range posts {
			<li>
				<a href={ templ.URL("/post/" + post.Slug) }>
					{ post.Title }
				</a>
				<small class="post-date">
					{ post.displayDate }
				</small>
			</li>
		}
	</ul>
}
