package rss

import (
	"blog/internal/rss/store"
	"blog/internal/ui"
)

templ ReadingPage(items []store.RssItem) {
	@ui.Layout("Reading List") {
		<section class="mx-auto w-full max-w-2xl px-4 sm:px-5">
			<h1 class="mb-1 text-3xl">Reading List</h1>
			<p class="mb-7 text-muted">Things worth reading, pulled from my feeds</p>
			if len(items) == 0 {
				<p class="border-t border-line pt-8 text-muted">Nothing here yet.</p>
			} else {
				<ul class="border-t border-line">
					for _, item := range items {
						<li class="border-b border-line py-5">
							<a
								href={ templ.URL(item.Link) }
								target="_blank"
								rel="noopener noreferrer"
								class="hover:underline hover:decoration-accent/40 hover:underline-offset-[0.15em]"
							>
								{ item.Title }
							</a>
							<div class="mt-1 flex flex-wrap items-center gap-x-2 text-[0.8rem] text-muted tabular-nums">
								<span>{ item.FeedName }</span>
								if item.PublishedAt != nil {
									<span aria-hidden="true">·</span>
									<span>{ item.PublishedAt.Format("Jan 02, 2006") }</span>
								}
								if item.IsSaved {
									<span aria-hidden="true">·</span>
									<span class="text-accent">saved</span>
								}
								if item.SeenAt != nil {
									<span aria-hidden="true">·</span>
									<span>seen</span>
								}
							</div>
							if item.Description != nil && *item.Description != "" {
								<p class="mt-2 line-clamp-2 text-[0.95rem] text-muted">
									{ *item.Description }
								</p>
							}
						</li>
					}
				</ul>
			}
		</section>
	}
}
