package ui

templ AboutPage() {
	@Layout("About", "Mohammad Lashkari — software engineer. Notes on things I build and the occasional experiment.", "about") {
		<article class="mx-auto w-full max-w-shell px-4 sm:px-5">
			<h1 class="mb-7 text-3xl">About</h1>
			<img
				src="/static/img/avatar.jpg"
				alt="Mohammad"
				loading="lazy"
				width="160"
				height="160"
				class="mb-7 size-40 rounded-lg object-cover"
			/>
			<p class="mb-7">
				Hey, I'm Mohammad. I enjoy writing code and knowing what happens behind the scenes. This is where I share my thoughts, notes, and experiments along the way.
			</p>
			<div class="flex flex-wrap gap-4 text-[0.95rem]">
				<a href="mailto:moe.lashkari@gmail.com" class="text-accent hover:text-accent-hover hover:underline">
					Gmail
				</a>
				<a
					href="https://github.com/mohammadlashkari"
					target="_blank"
					rel="noopener noreferrer"
					class="text-accent hover:text-accent-hover hover:underline"
				>
					GitHub
				</a>
				<a
					href="https://www.linkedin.com/in/mohammadlashkari"
					target="_blank"
					rel="noopener noreferrer"
					class="text-accent hover:text-accent-hover hover:underline"
				>
					LinkedIn
				</a>
				<a
					href="/static/resume.pdf"
					download
					class="text-accent hover:text-accent-hover hover:underline"
				>
					Resume
				</a>
			</div>
		</article>
	}
}
