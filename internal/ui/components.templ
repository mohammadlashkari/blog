package ui

script initWasm() {
    const go = new Go();
    WebAssembly.instantiateStreaming(
        fetch("/static/bin/life.wasm"),
        go.importObject,
    ).then((result) => {
        go.run(result.instance);
    });
}

templ GameOfLifeEmbed() {
	<figure class="mt-8 mb-10">
		<canvas
			id="board"
			class="block aspect-square w-full rounded-md border border-line bg-paper"
		></canvas>
		<figcaption class="mt-3 flex flex-wrap items-center justify-between gap-3">
			<button
				id="pauseButton"
				class="cursor-pointer rounded-md border border-line px-3 py-1.5 text-[0.85rem] hover:border-accent hover:text-accent"
			>Pause</button>
		</figcaption>
	</figure>
	<script src="/static/wasm_exec.js"></script>
	@initWasm()
}
